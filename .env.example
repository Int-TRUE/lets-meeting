# Local development only. Never prefix these values with VITE_.
MATTERMOST_ENABLED=false
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOT_ID=
MATTERMOST_BOT_TOKEN=
MATTERMOST_USER_MAP={}
ROBOT_BUTLER_URL=http://localhost:5173

# Deployed server: demo relay outbox (server-only; separate secrets per environment).
MATTERMOST_RELAY_ENABLED=false
MATTERMOST_RELAY_TOKEN=
MATTERMOST_RELAY_RECIPIENTS=
# Mac relay only, in .env.mattermost-local/relay.env together with Mattermost variables.
MATTERMOST_RELAY_ORIGIN=https://robot-butler.vercel.app
MATTERMOST_RELAY_JOURNAL=data/mattermost-relay.sqlite
